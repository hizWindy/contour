{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "engine/frontend", "run", "dev"],
      "port": 5173,
      "url": "http://localhost:5173"
    },
    {
      "name": "backend",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "--directory", "engine/backend", "engine", "serve"],
      "port": 8000
    }
  ]
}

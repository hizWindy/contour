# Copy this file to .env and fill in the values. Never commit .env.

# Database (Docker, see docker-compose.yml)
POSTGRES_USER=leadfinder
POSTGRES_PASSWORD=change-me
POSTGRES_DB=leadfinder
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
# TLS to the database. Leave these out on this computer. A managed database (DigitalOcean) needs
# POSTGRES_SSLMODE=require at least. verify-full also checks who answered, and then needs
# POSTGRES_SSLROOTCERT, the path of the provider's CA certificate file (in the container, a mounted file).
# POSTGRES_SSLMODE=verify-full
# POSTGRES_SSLROOTCERT=/run/secrets/db-ca.pem

# Claude. Set a spend limit in the Anthropic Console first.
ANTHROPIC_API_KEY=

# Signal Hire (company details, staff counts, and senior people's names and job titles; never an
# email or a phone). Leave empty to turn it off. Its support must switch the Company API on for the
# account first: a 403 means it is still off, and then no company details are read.
# The research uses it only when headcount_tool is listed in size.staff_sources in criteria.yaml.
SIGNALHIRE_API_KEY=

# Reading a company's details costs 1 Signal Hire company credit. A run reads at most this many
# new ones (a saved copy is free, so 0 means saved copies only), and a saved copy is used for this
# many days.
# SIGNALHIRE_MAX_CREDITS_PER_RUN=20
# SIGNALHIRE_DETAILS_FRESH_DAYS=30

# Email (PLAN-V9 C1). log (the default) writes each email to the backend log and sends nothing.
# resend sends through Resend's web API: it needs the key and a sender address on a domain Resend
# has checked. `uv run engine email-test --to you@example.com` sends one test email.
# EMAIL_PROVIDER=log
# EMAIL_API_KEY=
# EMAIL_FROM=Contour HQ <leads@example.com>
# The website's address, for links in emails. Empty: the public origin, else the laptop's.
# APP_URL=http://localhost:5173
# Who gets the email when a scheduled Lead Finder run ends, comma-separated (PLAN-V9 C2, TBC).
# A run started by hand never emails.
# LEAD_FINDER_NOTIFY_EMAILS=

# Spending ceilings (env-only: they change only here, then a restart). The Settings page sets the
# limits under them (9 Nov): a run a person starts (US$20, up to HARD_RUN_CAP_USD), an automatic
# run that a schedule starts (US$150, up to HARD_SCHEDULED_RUN_CAP_USD), one round of the city
# schedules together (US$150, up to HARD_SCHEDULED_RUN_CAP_USD too), and all runs in one day
# (US$150, up to HARD_DAILY_CAP_USD). The automatic runs also aim for a goal of good leads every 2
# weeks (100), set on the Settings page.
# HARD_RUN_CAP_USD=50
# HARD_SCHEDULED_RUN_CAP_USD=200
# HARD_DAILY_CAP_USD=300

# May the name of a company that came from HubSpot (the watchlist) be sent to Signal Hire?
# Off until Levi says yes. Only the exact text true turns it on.
# HUBSPOT_NAMES_TO_SIGNALHIRE_OK=false

# Sign-in (PLAN-V6). Off on this computer, so local work needs no password. Only the exact text true
# turns it on. A server always has it on. Make the account first: uv run engine create-admin
# AUTH_REQUIRED=false
# Signed out after this many minutes without a request, and after this many hours whatever. "Keep me
# signed in" has no idle limit and lasts this many days.
# SESSION_IDLE_MINUTES=120
# SESSION_MAX_HOURS=12
# SESSION_REMEMBER_DAYS=14
# Over HTTPS the cookie is Secure and named __Host-contour_session. Leave off on http://localhost.
# SESSION_COOKIE_SECURE=false
# Guessing: the first 2 wrong tries in a row cost nothing, each one after makes the next wait longer
# (2 seconds, doubling, up to a minute), and the 10th in a row locks the account for 15 minutes. One
# IP address may make 20 wrong tries in 15 minutes.
# LOGIN_FREE_TRIES=2
# LOGIN_LOCK_TRIES=10
# LOGIN_LOCK_MINUTES=15
# LOGIN_IP_MAX_FAILURES=20
# LOGIN_IP_WINDOW_MINUTES=15

# Server mode (PLAN-V6). For the server only: leave it off on this computer, where the engine answers
# to localhost and 127.0.0.1 and nothing else. SERVER_MODE=true makes it answer to one domain, behind
# Caddy and HTTPS. It needs PUBLIC_ORIGIN and one of TRUSTED_PROXIES or CLIENT_IP_HEADER, or it
# won't start. It also turns sign-in and the Secure cookie on, stops migrating at start (the migrate
# step runs first) and stops serving the Swagger pages. Writing AUTH_REQUIRED=false,
# SESSION_COOKIE_SECURE=false or AUTO_MIGRATE=true with it is refused, so a setting you wrote can't
# be quietly ignored.
# SERVER_MODE=false
# The website's address on the internet: https only, no path.
# PUBLIC_ORIGIN=https://hq.contourinteriors.com.au
# The address of Caddy as the engine sees it (a comma-separated list; an IP address or a network, never *).
# Only a connection from here may say what a client's IP address is.
# TRUSTED_PROXIES=172.18.0.0/16
# Instead of TRUSTED_PROXIES, never both: on DigitalOcean App Platform, the name of the header its
# front door writes the visitor's real address in. Only safe where nothing reaches the backend
# except through that front door (PLAN-V8).
# CLIENT_IP_HEADER=do-connecting-ip

# The first Admin account (PLAN-V8), for a server where nobody can type at the create-admin prompt.
# With both set and no Admin yet, `engine migrate` makes the account. Once an Admin exists they are
# ignored, so remove the password then. The password follows the same rules as create-admin: 14
# characters or more. An empty value counts as not set.
# FIRST_ADMIN_EMAIL=you@example.com
# FIRST_ADMIN_PASSWORD=
# FIRST_ADMIN_USERNAME=
# FIRST_ADMIN_NAME=

# Optional. These are the defaults; uncomment to change one.
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=medium
# CLAUDE_CONCURRENCY=2
# COMPANY_CAP_USD=2.50
# COMPANY_MAX_SEARCHES=12
# SEARCHES_PER_REQUEST=3
# FETCHES_PER_REQUEST=3
# MEMORY_FRESH_DAYS=30

# HubSpot (PLAN-V5): the service key from HubSpot's Settings > Integrations > Service keys.
# Leave empty to keep HubSpot off: then nothing reaches HubSpot and the export upload still works.
HUBSPOT_SERVICE_KEY=

# Writing to HubSpot stays off until the key has the write scopes and one live write was checked.
# Only the exact text true turns it on.
# HUBSPOT_WRITE_ENABLED=false
# HUBSPOT_API_VERSION=2026-09
# HUBSPOT_REQUESTS_PER_SECOND=8
# HUBSPOT_SEARCHES_PER_SECOND=4
# A sync starts with the backend when the last one is older than this (0 = never at start), and
# reads everything (finding deleted records) when the last full one is older than this many days.
# HUBSPOT_SYNC_MAX_AGE_HOURS=24
# HUBSPOT_FULL_SYNC_DAYS=7


# Copy this file to .env and fill in the values. Never commit .env.

# Database (Docker, see docker-compose.yml)
POSTGRES_USER=leadfinder
POSTGRES_PASSWORD=change-me
POSTGRES_DB=leadfinder
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433

# Claude. Set a spend limit in the Anthropic Console first.
ANTHROPIC_API_KEY=

# Signal Hire (company details, staff counts, and senior people's names and job titles; never an
# email or a phone). Leave empty to turn it off. Its support must switch the Company API on for the
# account first: a 403 means it is still off, and then no company details are read.
# The research uses it only when headcount_tool is listed in size.staff_sources in criteria.yaml.
SIGNALHIRE_API_KEY=

# Reading a company's details costs 1 Signal Hire company credit. A run reads at most this many
# new ones (a saved copy is free, so 0 means saved copies only), and a saved copy is used for this
# many days.
# SIGNALHIRE_MAX_CREDITS_PER_RUN=20
# SIGNALHIRE_DETAILS_FRESH_DAYS=30

# May the name of a company that came from HubSpot (the watchlist) be sent to Signal Hire?
# Off until Levi says yes. Only the exact text true turns it on.
# HUBSPOT_NAMES_TO_SIGNALHIRE_OK=false

# Optional. These are the defaults; uncomment to change one.
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=medium
# CLAUDE_CONCURRENCY=2
# COMPANY_CAP_USD=2.50
# COMPANY_MAX_SEARCHES=12
# SEARCHES_PER_REQUEST=3
# FETCHES_PER_REQUEST=3
# MEMORY_FRESH_DAYS=30

# HubSpot (PLAN-V5): the service key from HubSpot's Settings > Integrations > Service keys.
# Leave empty to keep HubSpot off: then nothing reaches HubSpot and the export upload still works.
HUBSPOT_SERVICE_KEY=

# Writing to HubSpot stays off until the key has the write scopes and one live write was checked.
# Only the exact text true turns it on.
# HUBSPOT_WRITE_ENABLED=false
# HUBSPOT_API_VERSION=2026-09
# HUBSPOT_REQUESTS_PER_SECOND=8
# HUBSPOT_SEARCHES_PER_SECOND=4
# A sync starts with the backend when the last one is older than this (0 = never at start), and
# reads everything (finding deleted records) when the last full one is older than this many days.
# HUBSPOT_SYNC_MAX_AGE_HOURS=24
# HUBSPOT_FULL_SYNC_DAYS=7


# Copy this file to .env and fill in the values. Never commit .env.

# Database (Docker, see docker-compose.yml)
POSTGRES_USER=leadfinder
POSTGRES_PASSWORD=change-me
POSTGRES_DB=leadfinder
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433

# Claude. Set a spend limit in the Anthropic Console first.
ANTHROPIC_API_KEY=


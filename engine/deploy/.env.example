# Copy this file to .env in this folder, fill it in, and make it readable by you only:
#   cp .env.example .env && chmod 600 .env
# Never commit .env. It holds the keys.

# Makes `docker compose` use the production file in this folder. Keep this line: without it, compose
# would climb to the folder above and use the file for the development database there.
COMPOSE_FILE=docker-compose.prod.yml
# For a trial on a laptop only: also start a database of its own. Leave this out on the server.
# COMPOSE_PROFILES=trial

# The domain, with no https://. Caddy gets the certificate for it by itself. On a laptop trial use
# localhost (Caddy then makes its own local certificate, and a browser warns until it is trusted).
SITE_ADDRESS=hq.contourinteriors.com.au
# Strict-Transport-Security. Leave the default on the server. On a laptop trial use max-age=0, so a
# browser doesn't remember https for localhost.
# HSTS=max-age=31536000

# The database. A laptop trial starts a database of its own (COMPOSE_PROFILES=trial above):
# leave POSTGRES_HOST out, and choose any password. On the server it is the managed database: copy
# its host, port, user, name and password from the DigitalOcean page.
POSTGRES_USER=leadfinder
POSTGRES_PASSWORD=change-me
POSTGRES_DB=leadfinder
# POSTGRES_HOST=db-postgresql-syd1-00000-do-user-0000000-0.k.db.ondigitalocean.com
# POSTGRES_PORT=25060
# A managed database needs TLS. verify-full also checks who answered, and then needs the provider's
# CA certificate file mounted in the backend (add a volume for it in docker-compose.prod.yml).
# POSTGRES_SSLMODE=require
# The backend opens at most 25 database connections (DB_POOL_SIZE 10 + DB_MAX_OVERFLOW 10 + 4 for the
# run checkpoints + 1 lock). DigitalOcean's smallest managed database allows about 22 (TBC): on that
# plan, keep the backend to 15.
# DB_POOL_SIZE=6
# DB_MAX_OVERFLOW=4

# Claude. Set a spend limit in the Anthropic Console first.
ANTHROPIC_API_KEY=

# HubSpot (read only until writing is switched on). Leave empty to keep HubSpot off.
HUBSPOT_SERVICE_KEY=
# HUBSPOT_WRITE_ENABLED=false

# Signal Hire. Leave empty to turn it off.
SIGNALHIRE_API_KEY=

# Not set here, on purpose: SERVER_MODE, PUBLIC_ORIGIN and TRUSTED_PROXIES (the compose file sets
# them), and AUTH_REQUIRED, SESSION_COOKIE_SECURE and AUTO_MIGRATE (server mode refuses them).
# See ../.env.example for every other setting.
